    "package:reading-preview": "npm run build:pages && node scripts/package-reading-preview.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "test": "vitest run",
    "build:pages": "vite build --base=/deddeh.com/",
    "verify:card-selector": "node scripts/verify-card-selector.mjs",
    "verify:reading": "node scripts/verify-reading.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:music": "node scripts/verify-music.mjs",
    "verify:music-design": "node scripts/verify-music-design.mjs",
    "package:music-preview": "npm run build:pages && node scripts/package-music-preview.mjs"
